{
  // 배포 절차
  //   cd server
  //   npm install
  //   npx wrangler secret put ANTHROPIC_API_KEY   → Anthropic 콘솔에서 발급한 키
  //   npx wrangler deploy
  //
  // 앱은 /ocr 하나만 호출한다. API 키는 Worker secret 에만 있고 번들에는 들어가지 않는다.
  "name": "pillcheck-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // 하루 호출 한도를 세는 KV. 남용·사고성 과금을 막는 안전장치다.
  "kv_namespaces": [
    {
      "binding": "RATE",
      "id": "PLACEHOLDER_KV_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
